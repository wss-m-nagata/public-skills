                </mxCell>
                <mxCell id="n22" value="お知らせ添付ファイル" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;fontColor=#37474F;" vertex="1" parent="1">
                    <mxGeometry x="40" y="575" width="250" height="30" as="geometry" />
