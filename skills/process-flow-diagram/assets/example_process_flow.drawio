                <mxCell id="n24" value="公開履歴" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;fontColor=#37474F;" vertex="1" parent="1">
