                <mxCell id="n27" value="common.user_master" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;fontColor=#37474F;" vertex="1" parent="1">
                    <mxGeometry x="290" y="635" width="330" height="30" as="geometry" />
                </mxCell>
                <mxCell id="n28" value="この図の範囲" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#37474F;" vertex="1" parent="1">
                    <mxGeometry x="1060" y="400" width="300" height="20" as="geometry" />
                </mxCell>
                <mxCell id="n29" value="・「お知らせ管理」を対象とする。&lt;br&gt;・公開後の通知メール送信は、この操作より後の工程のため含めない（「通知機能」の図）。&lt;br&gt;・現行の実装（As-Is）をそのまま図にしている。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;fontColor=#5D4037;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="1060" y="425" width="620" height="145" as="geometry" />
                </mxCell>
                <mxCell id="n30" value="確認が必要な事項の書きかた" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#37474F;" vertex="1" parent="1">
                    <mxGeometry x="700" y="600" width="300" height="20" as="geometry" />
                </mxCell>
                <mxCell id="n31" value="&lt;b&gt;T.B.D　実装者に確認&lt;/b&gt;&lt;br&gt;仕様が未確定な箇所、実装が要件を満たしていない箇所は、この赤い破線の枠で示す。冒頭に「T.B.D　実装者に確認」と書き、続けて&lt;b&gt;何を確認したいのか&lt;/b&gt;を箇条書きにする。&lt;br&gt;AIが書いたものは、&lt;b&gt;末尾に自動生成である旨を必ず添える&lt;/b&gt;（下記の定型文）。&lt;br&gt;他の処理フロー図でも同じ書式を使う。&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;※ この T.B.D はAIの自動生成です。内容は必ずしも正しいとは限りません。重要な情報は確認するようにしてください。&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;dashed=1;fontColor=#B71C1C;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
