    <diagram id="page3" name="③凡例・和名対応">
        <mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1100" math="0" shadow="0" background="#FFFFFF">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="n1" value="③ 凡例と和名の対応" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#263238;" vertex="1" parent="1">
                    <mxGeometry x="40" y="24" width="1200" height="30" as="geometry" />
                </mxCell>
                <mxCell id="n2" value="記号の意味" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#37474F;" vertex="1" parent="1">
                    <mxGeometry x="40" y="80" width="300" height="20" as="geometry" />
                </mxCell>
                <mxCell id="n3" value="画面" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;strokeWidth=2;fontColor=#0D47A1;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="40" y="110" width="240" height="44" as="geometry" />
                </mxCell>
                <mxCell id="n4" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda_function;" vertex="1" parent="1">
                    <mxGeometry x="40" y="170" width="36" height="36" as="geometry" />
                </mxCell>
                <mxCell id="n5" value="処理（何をするかを1〜2行で書く）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#333333;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
