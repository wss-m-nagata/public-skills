        </mxCell>
        <mxCell id="b5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="835" y="355" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="835" y="545" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="950" y="835" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="b8" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1250" y="835" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c1-legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1670" y="30" width="650" height="840" as="geometry" />
        </mxCell>
        <mxCell id="c1-step1-badge" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1690" y="56" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c1-step1-text" value="&lt;b&gt;アクセス&lt;/b&gt;&lt;div&gt;CloudFrontにHTTPSで接続する。IP制限を採用する場合は、WAFで送信元を確認する。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1742" y="54" width="558" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1-step2-badge" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1690" y="132" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c1-step2-text" value="&lt;div&gt;&lt;b&gt;画面の配信&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;既定の転送先。S3の静的ファイルを返す。CloudFront Functionsが、拡張子のないパスを /index.html に書き換える。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1742" y="130" width="558" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1-step3-badge" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1690" y="208" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c1-step3-text" value="&lt;b&gt;APIの転送&lt;/b&gt;&lt;div&gt;CloudFrontがサービスのREST APIへ転送し、REST APIがLambdaを呼び出す。IP制限を採用する場合は、API側のWAFでもCloudFrontからの要求か確認する。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1742" y="206" width="558" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1-step4-badge" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1690" y="284" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c1-step4-text" value="&lt;b&gt;DBへの接続&lt;/b&gt;&lt;div&gt;DBを利用するサービスでは、接続先とネットワークをDBの設計に合わせる。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1742" y="282" width="558" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1-step5-badge" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1690" y="360" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c1-step5-text" value="&lt;b&gt;トークンの確認&lt;/b&gt;&lt;div&gt;Cognitoを採用する場合、Lambdaが発行者の公開鍵でトークンを検証する。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1742" y="358" width="558" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1-step6-badge" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1690" y="436" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c1-step6-text" value="&lt;b&gt;転送先の登録&lt;/b&gt;&lt;div&gt;サービスがAPI URLをSSMに登録し、共有インフラが読み取ってCloudFrontの転送先を更新する。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1742" y="434" width="558" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1-step7-badge" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1690" y="512" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c1-step7-text" value="&lt;b&gt;継続デプロイ&lt;/b&gt;&lt;div&gt;GitHub Actionsを採用する場合は、OIDCでIAMロールを引き受ける。実行条件は環境ごとに決める。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1742" y="510" width="558" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1-step8-badge" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1690" y="588" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c1-step8-text" value="&lt;b&gt;管理者の初回準備&lt;/b&gt;&lt;div&gt;未準備のアカウント・リージョンをブートストラップする。GitHub Actionsを使う場合はOIDCとデプロイ用IAMロールを用意する。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1742" y="586" width="558" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1-legend-notes" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br/&gt;実線の枠: 本CDKで作る・参照するもの&lt;br/&gt;点線の枠: 外部が管理するもの（本CDKの対象外）&lt;br/&gt;赤い点線の矢印: WAFの関連付け&lt;br/&gt;灰色の点線の矢印: デプロイ時の値の受け渡し" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;labelBackgroundColor=none;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1690" y="668" width="610" height="188" as="geometry" />
        </mxCell>
        <mxCell id="svc-api-gateway" value="API Gateway&lt;br&gt;REST API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E8;strokeColor=#ED7100;" parent="aws-cloud" vertex="1">
          <mxGeometry x="306" y="303" width="108" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-gateway-lambda" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#232F3E;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;fontFamily=Helvetica;" parent="1" source="svc-api-gateway" target="grp-svc-lambda" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="スタック構成" id="diagram-stack-c">
    <mxGraphModel dx="1334" dy="232" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2300" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4-title-group" value="" style="group;fontFamily=Helvetica;" parent="1" connectable="0" vertex="1">
          <mxGeometry x="50" y="30" width="1500" height="83" as="geometry" />
        </mxCell>
        <mxCell id="p4-title" value="スタック構成（API Gateway）" style="text;html=1;resizable=1;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=30;fontStyle=1;fontFamily=Helvetica;" parent="p4-title-group" vertex="1">
          <mxGeometry width="615" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p4-subtitle" value="画面用の入口を先に作成する。サービスのREST APIをデプロイしてから、入口にAPIの転送先を追加する。" style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=16;fontFamily=Helvetica;" parent="p4-title-group" vertex="1">
          <mxGeometry x="5" y="40" width="1200" height="25" as="geometry" />
        </mxCell>
        <mxCell id="p4-sep" value="" style="line;strokeWidth=2;html=1;fontSize=14;strokeColor=#FF9900;fontFamily=Helvetica;" parent="p4-title-group" vertex="1">
          <mxGeometry x="5" y="70" width="1490" height="10" as="geometry" />
        </mxCell>
        <mxCell id="fr-found" value="&lt;b&gt;管理基盤 App&lt;/b&gt;&lt;br/&gt;管理者がローカルでデプロイする。変更が少ない" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#666666;container=0;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="60" y="150" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="fr-shared" value="&lt;b&gt;共通インフラ App&lt;/b&gt;&lt;br/&gt;全サービスと画面で共通に使う。変更の影響が大きい" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C4FFF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#8C4FFF;container=0;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="60" y="370" width="1150" height="220" as="geometry" />
        </mxCell>
        <mxCell id="fr-svc" value="&lt;b&gt;サービス App（サービスごとに1つ）&lt;/b&gt;&lt;br/&gt;サービスごとに、独立してデプロイする。サービスどうしは依存しない" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ED7100;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#ED7100;container=0;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="60" y="650" width="1150" height="220" as="geometry" />
        </mxCell>
        <mxCell id="stk-dep" value="&lt;b&gt;{識別名}-githubactions-{env}&lt;/b&gt;&lt;div&gt;&lt;b&gt;デプロイの権限&lt;/b&gt;&lt;/div&gt;&lt;div&gt;GitHub Actionsが、各スタックをデプロイするための権限を与える。すべてのデプロイの前提&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#232F3E;shadow=1;strokeWidth=1.5;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="90" y="195" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="stk-wafcf" value="&lt;b&gt;アクセス制限（採用時）&lt;/b&gt;&lt;div&gt;CloudFront用とREST API用のWAFを、それぞれのリージョンで管理する。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#EDE7F6;strokeColor=#8C4FFF;fontColor=#232F3E;shadow=1;strokeWidth=1.5;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="90" y="420" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="stk-web" value="&lt;b&gt;入口&lt;/b&gt;&lt;div&gt;画面の置き場とCloudFrontを作る。サービスのデプロイ後にAPIの転送先を追加する。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#EDE7F6;strokeColor=#8C4FFF;fontColor=#232F3E;shadow=1;strokeWidth=1.5;fontFamily=Helvetica;" parent="1" vertex="1">
