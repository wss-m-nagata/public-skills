        <mxCell id="stk-svc-b" value="&lt;b&gt;別のサービス&lt;/b&gt;&lt;div&gt;対象のREST APIを配置して、入口にその転送先を追加する。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF2E8;strokeColor=#ED7100;fontColor=#232F3E;shadow=1;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontFamily=Helvetica;" parent="1" vertex="1">
