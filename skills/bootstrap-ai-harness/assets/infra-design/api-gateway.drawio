        </mxCell>
        <mxCell id="stk-auth" value="&lt;b&gt;{識別名}&lt;/b&gt;&lt;b&gt;-webappauth-{env}&lt;/b&gt;&lt;div&gt;&lt;b&gt;認証&lt;/b&gt;&lt;/div&gt;&lt;div&gt;ログインとトークンの発行。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#EDE7F6;strokeColor=#8C4FFF;fontColor=#232F3E;shadow=1;strokeWidth=1.5;fontFamily=Helvetica;" parent="1" vertex="1">
