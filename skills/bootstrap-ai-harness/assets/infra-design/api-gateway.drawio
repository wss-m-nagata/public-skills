        </mxCell>
        <mxCell id="p4-step1-text" value="&lt;b&gt;管理基盤（GitHub Actionsを採用する場合）&lt;/b&gt;&lt;div&gt;OIDCとデプロイ用IAMロールを用意する。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1712" y="54" width="468" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4-step2-badge" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1660" y="132" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p4-step2-text" value="&lt;b&gt;WAF（IP制限を採用する場合）&lt;/b&gt;&lt;div&gt;CloudFront用とREST API用を、利用側の前に用意する。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1712" y="130" width="468" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4-step3-badge" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1660" y="208" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p4-step3-text" value="&lt;b&gt;画面用の入口&lt;/b&gt;&lt;div&gt;サービスのREST APIがまだ存在しない状態で、画面用の入口を作る。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1712" y="206" width="468" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4-step4-badge" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1660" y="284" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p4-step4-text" value="&lt;b&gt;認証（採用する場合）&lt;/b&gt;&lt;div&gt;招待メールに画面URLを載せる場合は、入口のURLを参照する。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1712" y="282" width="468" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4-step5-badge" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1660" y="360" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p4-step5-text" value="&lt;b&gt;サービス、API転送先、画面&lt;/b&gt;&lt;div&gt;REST APIをデプロイしてURLをSSMに登録する。共有インフラで転送先を更新してから、画面を配信する。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1712" y="358" width="468" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4-legend-notes" value="&lt;b&gt;デプロイの順序&lt;/b&gt;&lt;div&gt;管理基盤 → WAF（採用時） → 画面用入口 → 認証（採用時） → REST API → 転送先追加 → 画面配信&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;labelBackgroundColor=none;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1660" y="440" width="520" height="516" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
